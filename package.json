{
  "name": "octo",
  "productName": "Octo",
  "version": "1.1.0",
  "description": "Keep all your messaging services in one window.",
  "main": "electron/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Techblogogy/Octo.git"
  },
  "bugs": {
    "url": "https://github.com/Techblogogy/Octo/issues"
  },
  "homepage": "https://github.com/Techblogogy/Octo",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "build:css": "sass --no-source-map sass/octo.scss resources/octo.css",
    "watch:css": "sass --watch sass/octo.scss resources/octo.css",
    "clean": "rm -rf ./dist",
    "build": "npm run build:linux && npm run build:osx && npm run build:win",
    "build:osx": "electron-builder --macos",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "build": {
    "productName": "Octo",
    "appId": "com.techblogogy.octo",
    "asar": true,
    "files": [
      "electron/**",
      "app/**",
      "resources/**",
      "overrides/**",
      "packages/local/rambox-default-theme/overrides/**",
      "ext/build/ext-all.js",
      "ext/src/ux/**",
      "ext/packages/ext-theme-crisp/build/**",
      "ext/packages/ext-locale/build/**",
      "index.html",
      "masterpassword.html",
      "app.js",
      "env.js"
    ],
    "directories": {
      "buildResources": "resources/installer/",
      "output": "dist/"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Octo",
      "iconSize": 128,
      "contents": [
        {
          "x": 355,
          "y": 125,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 155,
          "y": 125,
          "type": "file"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ]
    }
  },
  "devDependencies": {
    "electron": "^24.1.0",
    "electron-builder": "^23.6.0",
    "sass": "^1.62.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "electron-store": "^8.1.0",
    "mime": "^3.0.0",
    "tmp": "^0.2.1"
  }
}
